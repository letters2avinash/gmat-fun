# Supabase project settings (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter — used for the AI chat (Phase 2) and any generation logic
OPENROUTER_API_KEY=

# Test series chatbot (sazzag.gmat.fun). Optional: the assistant shows a
# "not configured" message until OPENROUTER_API_KEY is set.
SERIES_CHAT_MODEL=anthropic/claude-sonnet-4
